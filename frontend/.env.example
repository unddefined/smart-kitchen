# =============================================================================
# Smart Kitchen System - Frontend 环境变量示例
# =============================================================================
# 使用说明：
# 1. 复制此文件为 .env（默认）或 .env.development / .env.production
# 2. 根据实际情况修改配置值
# 3. 切勿将包含真实 API 地址的配置文件提交到 Git
# =============================================================================

# API 基础地址
VITE_API_BASE_URL=http://localhost:3001

# WebSocket 地址（可选，默认从 API URL 推导）
# VITE_WS_URL=ws://localhost:3001

# 应用标题
VITE_APP_TITLE=Smart Kitchen System

# PWA 配置
VITE_PWA_ENABLED=true

# 是否启用 Source Map
VITE_SOURCE_MAP=true

# 日志级别 (debug | info | warn | error)
VITE_LOG_LEVEL=debug
